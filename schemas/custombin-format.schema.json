{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:custombin:format-schema:1",
  "title": "Custom Binary Viewer Format",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^\\$": true },
  "required": ["schemaVersion", "id", "name", "fields"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "$schema": { "type": "string" },
    "$id": { "type": "string" },
    "$comment": { "type": "string" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "provenance": { "type": "string" },
    "references": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2048 }, "default": [] },
    "meta": { "$ref": "#/$defs/meta" },
    "description": { "type": "string" },
    "fileExtensions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9_-]+$" },
      "uniqueItems": true,
      "default": []
    },
    "endianness": { "enum": ["little", "big"], "default": "little" },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 100, "default": 0 },
    "minSize": { "type": "integer", "minimum": 0 },
    "maxSize": { "type": "integer", "minimum": 0 },
    "magic": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": { "^\\$": true },
        "required": ["offset", "bytes"],
        "properties": {
          "offset": { "type": "integer", "minimum": 0 },
          "bytes": { "type": "string", "pattern": "^([0-9A-Fa-f]{2})+$" },
          "required": { "type": "boolean", "default": true },
          "description": { "type": "string" }
        }
      },
      "default": []
    },
    "fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/field" },
      "minItems": 1,
      "maxItems": 4096
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^\\$": true },
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "offset": { "type": "integer", "minimum": 0 },
        "type": {
          "enum": ["u8", "i8", "u16", "i16", "u32", "i32", "u64", "i64", "f32", "f64", "bytes", "string", "struct", "section"]
        },
        "endianness": { "enum": ["little", "big"] },
        "length": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "lengthFrom": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\[\\d+\\])?(\\.[A-Za-z_][A-Za-z0-9_]*(\\[\\d+\\])?)*$" },
        "encoding": { "enum": ["ascii", "utf8", "utf16le", "hex"] },
        "trimNull": { "type": "boolean", "default": true },
        "count": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "repeatToEof": { "type": "boolean", "default": false },
        "stride": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "itemLength": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "enum": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": { "^\\$": true },
            "required": ["mask", "label"],
            "properties": {
              "mask": { "type": "integer", "minimum": 0 },
              "label": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" },
          "maxItems": 4096
        },
        "format": { "enum": ["decimal", "hex", "binary", "timestamp-unix", "raw"] },
        "required": { "type": "boolean", "default": false },
        "dependsOn": {
          "oneOf": [
            { "$ref": "#/$defs/dependency" },
            { "type": "array", "items": { "$ref": "#/$defs/dependency" }, "minItems": 1 }
          ]
        },
        "checksum": { "$ref": "#/$defs/checksum" },
        "hash": { "$ref": "#/$defs/hash" },
        "computed": { "$ref": "#/$defs/computed" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    "computed": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^\\$": true },
      "required": ["expression"],
      "properties": {
        "expression": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9_().,:[\\]\\s+-]+$" },
        "derive": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/deriveStep" }
        },
        "compare": { "$ref": "#/$defs/compare" },
        "severity": { "enum": ["error", "warning", "info"], "default": "error" }
      }
    },
    "deriveStep": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^\\$": true },
      "required": ["op"],
      "properties": {
        "op": { "enum": ["slice", "u32le", "le32", "u32be", "be32"] },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "const": "slice" } } },
          "then": { "required": ["start", "end"] }
        }
      ]
    },
    "compare": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^\\$": true },
      "properties": {
        "targetPath": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\[\\d+\\])?(\\.[A-Za-z_][A-Za-z0-9_]*(\\[\\d+\\])?)*$" },
        "mode": { "enum": ["auto", "numeric", "raw-bytes"], "default": "auto" }
      }
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^\\$": true },
      "required": ["algorithm", "range"],
      "properties": {
        "algorithm": { "enum": ["crc32", "crc32-reflected", "crc32-non-reflected"] },
        "range": { "$ref": "#/$defs/range" },
        "severity": { "enum": ["error", "warning", "info"], "default": "error" }
      }
    },
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^\\$": true },
      "required": ["algorithm", "range"],
      "properties": {
        "algorithm": { "enum": ["sha1", "sha256", "sha384", "sha512", "sha3-256", "sha3-384", "sha3-512"] },
        "range": { "$ref": "#/$defs/range" },
        "severity": { "enum": ["error", "warning", "info"], "default": "error" }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^\\$": true },
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "offsetFrom": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\[\\d+\\])?(\\.[A-Za-z_][A-Za-z0-9_]*(\\[\\d+\\])?)*$" },
        "length": { "type": "integer", "minimum": 0, "maximum": 104857600 },
        "lengthFrom": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\[\\d+\\])?(\\.[A-Za-z_][A-Za-z0-9_]*(\\[\\d+\\])?)*$" }
      },
      "oneOf": [
        { "required": ["offset"] },
        { "required": ["offsetFrom"] }
      ],
      "anyOf": [
        { "required": ["length"] },
        { "required": ["lengthFrom"] }
      ],
      "not": {
        "anyOf": [
          { "required": ["offset", "offsetFrom"] },
          { "required": ["length", "lengthFrom"] }
        ]
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^\\$": true },
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\[\\d+\\])?(\\.[A-Za-z_][A-Za-z0-9_]*(\\[\\d+\\])?)*$" },
        "present": { "type": "boolean" },
        "equals": { "type": ["string", "number", "boolean"] },
        "notEquals": { "type": ["string", "number", "boolean"] },
        "mask": { "type": "integer", "minimum": 0 }
      }
    },
    "meta": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" },
          { "type": "array", "items": { "type": "string" } }
        ]
      }
    }
  }
}
